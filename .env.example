# Quote form email (src/app/api/quote/route.ts). Sign up at https://resend.com, verify vcarremoval.com.au, then set:
RESEND_API_KEY=
# Inbox that receives quote requests (defaults to info@vcarremoval.com.au)
CONTACT_TO_EMAIL=info@vcarremoval.com.au
# Must be a sender on a domain verified in Resend, e.g. "V Car Removal Brisbane <quotes@vcarremoval.com.au>"
CONTACT_FROM_EMAIL=

# Google tag / GA4 (old site used GT-55B74RZ3). Leave blank to disable.
NEXT_PUBLIC_GA_ID=
# Google Ads (old site used AW-17981015409) + the conversion label from Google Ads > Goals > Conversions
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# Meta (Facebook) Pixel ID. Leave blank to disable.
NEXT_PUBLIC_META_PIXEL_ID=

# WordPress extraction script only (scripts/wp-extract.mjs), never needed by the site:
# WP_URL=https://vcarremoval.com.au
# WP_USER=
# WP_APP_PASSWORD=
