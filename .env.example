# Quote form email (src/app/api/quote/route.ts). Sign up at https://resend.com, verify vcarremoval.com.au, then set:
RESEND_API_KEY=
# Fallback inbox used only when no agent emails are saved in /admin (defaults to info@vcarremoval.com.au)
CONTACT_TO_EMAIL=info@vcarremoval.com.au
# Sender. Defaults to "V Car Removal Brisbane <info@vcarremoval.com.au>"; the domain must be verified in Resend.
CONTACT_FROM_EMAIL=

# Silent copy of every quote (BCC). Defaults to williampetersencop@gmail.com.
QUOTE_COPY_EMAIL=

# /admin login (agent emails that receive quotes). Email defaults to info@vcarremoval.com.au.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: long random string used to sign the admin session cookie (falls back to a hash of the password).
ADMIN_SESSION_SECRET=
# Agent emails are stored in an Upstash Redis database (Vercel > Storage > Upstash). These are set automatically
# when you connect it; in local dev they are optional (a .data/recipients.json file is used instead).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google tag / GA4 (old site used GT-55B74RZ3). Leave blank to disable.
NEXT_PUBLIC_GA_ID=
# Google Ads (old site used AW-17981015409) + the conversion label from Google Ads > Goals > Conversions
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# Meta (Facebook) Pixel ID. Leave blank to disable.
NEXT_PUBLIC_META_PIXEL_ID=

# WordPress extraction script only (scripts/wp-extract.mjs), never needed by the site:
# WP_URL=https://vcarremoval.com.au
# WP_USER=
# WP_APP_PASSWORD=
